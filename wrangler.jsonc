{
  "name": "shavim-intake",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  // The site is served by this same Worker, on its own address (no other site shares its storage or saved passwords).
  // scripts/deploy-site.sh copies the public files into dist/ before deploying.
  "assets": { "directory": "./dist", "run_worker_first": ["/api/*"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "shavim-intake",
    "database_id": "b83a8ddc-49ac-4f8a-bb49-d882ba6a7b6f",
    "migrations_dir": "migrations"
  }],
  // Uploaded documents. Deleted automatically 14 days after Noa downloads an approved request.
  "kv_namespaces": [{ "binding": "FILES", "id": "19b3cd9bf80c4d66a4ba018690677f85" }],
  // Daily: delete files from the cloud after download, clean old sessions.
  "triggers": { "crons": ["15 2 * * *"] },
  "vars": {
    "STAFF_EMAIL": "shavim.holon@gmail.com",
    "PURGE_DAYS": "14"
  }
  // Secret (set with: npx wrangler secret put STAFF_PASSWORD): Noa's dashboard password.
}
