{
  "name": "shavim-intake",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "shavim-intake",
    "database_id": "REPLACE_WITH_D1_ID",
    "migrations_dir": "migrations"
  }],
  // Uploaded documents. Deleted automatically 14 days after Noa downloads an approved request.
  "kv_namespaces": [{ "binding": "FILES", "id": "REPLACE_WITH_KV_ID" }],
  // Daily: delete files from the cloud after download, clean old sessions.
  "triggers": { "crons": ["15 2 * * *"] },
  "vars": {
    "STAFF_EMAIL": "noa@amutatshavim.co.il",
    "PURGE_DAYS": "14"
  }
  // Secret (set with: npx wrangler secret put STAFF_PASSWORD): Noa's dashboard password.
}
